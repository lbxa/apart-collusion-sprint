{
  "name": "collusion-sprint-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "sync:research": "bun scripts/sync-research.ts",
    "check:data": "bun scripts/sync-research.ts --check",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.tsx,.astro",
    "test": "bun test",
    "build": "bun run check:data && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "6.2.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "typescript": "5.9.3",
    "wrangler": "4.164.0"
  }
}
