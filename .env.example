# Keep real credentials in the ignored root .env or the cloud runner's secrets.
# This project owns its W&B destination independently of Epistemics.
WANDB_BASE_URL=https://api.wandb.ai
WANDB_ENTITY=lbxa-corp
WANDB_PROJECT=apart-collusion-sprint
WANDB_API_KEY=

# Cloudflare Workers AI: account-scoped API, not AI Gateway Unified Billing.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# All local harness processes must share one writable rate-limit store.
# Set an absolute path on the cloud runner when the default cache is unavailable.
# VERACITY_RATE_DB=/absolute/path/collusion/request-rate.sqlite

# Optional alternative provider. Do not enable fallbacks implicitly.
# OPENROUTER_API_KEY=
# OPENROUTER_BACKUP_API_KEY=
