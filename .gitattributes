# Keep imported research outputs verbatim, including original transcript spacing.
harness/historical-results/** -whitespace

# Preserve the released campaign bytes; large evidence files use Git LFS.
harness/archive/october-2026/results/campaign-2026-10-26/** -text -whitespace
harness/archive/october-2026/results/campaign-2026-10-26/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
harness/archive/october-2026/results/campaign-2026-10-26/**/*.sqlite filter=lfs diff=lfs merge=lfs -text
harness/archive/october-2026/results/campaign-2026-10-26/export/experiments/*.json filter=lfs diff=lfs merge=lfs -text
harness/archive/october-2026/results/campaign-2026-10-26/export/raw-data.zip filter=lfs diff=lfs merge=lfs -text

# Preserve the CRLF bytes covered by the November snapshot receipts.
report/data/collusion-progress-20261117/*.csv -text whitespace=cr-at-eol
report/data/collusion-progress-final-20261117/*.csv -text whitespace=cr-at-eol
